<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WebView 文件选择与 `<input capture>` 拍照 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- WebView RESOURCE_AUDIO_CAPTURE（getUserMedia 语音）映射的运行时权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 9 及以下下载文件需要写外部存储；API 29+ 使用 MediaStore/应用私有目录无需此权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Android 13+ 通知权限：原生 WebSocket 推送的系统通知需要 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WebSocket 后台保活：前台服务 + CPU/网络锁，维持 WebView 中的长连接 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 开启推送时主动申请电池优化豁免，保障常驻原生 WS 不被 Doze/省电策略断网 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="阈界人格"
        android:name=".LiminalApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- WebView 主壳：旋转/键盘等配置变化自行消化不重建（视频全屏转屏不中断、页面不重载）；
             刻意不含 uiMode——系统深浅色切换仍需重建 Activity 以刷新 WebView 主题与壳层联动。 -->
        <activity
            android:name=".NativeWebViewActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/NormalTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|locale|layoutDirection|fontScale|density"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- 推送权限设置向导：逐项引导开启通知/电池豁免/通知渠道，全部完成后才允许启用 App 推送。 -->
        <activity
            android:name=".PermissionSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Liminal.Wizard" />
        <service
            android:name=".KeepAliveService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- 打开外链需要浏览器可见性（Android 11+ 包过滤） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
