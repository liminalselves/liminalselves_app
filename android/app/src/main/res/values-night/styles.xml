<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 启动窗主题（系统深色模式开启时）：开屏窗口背景保持到 Activity 首帧绘制为止 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowFullscreen">false</item>
        <!-- 夜间开屏跟随系统深色：深色背景（@color/splash_background 夜间为 #15171C）
             + 深色系统栏 + 浅色图标，logo 用 drawable-night-* 深色版，避免夜间启动白屏闪光 -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
    <!-- 常规窗口主题：Activity 启动后的窗口底色，显示在原生壳层 UI 之下 -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- 夜间兜底窗口背景取深色（Theme.Light 的 colorBackground 恒为白色），
             NativeWebViewActivity 首帧前的窗口闪白会与深色开屏形成反差 -->
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- 推送权限向导专用主题：即使系统处于深色模式也保持浅色，与主页壳层一致 -->
    <style name="Theme.Liminal.Wizard" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#F7F9F5</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
