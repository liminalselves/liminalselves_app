<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowFullscreen">false</item>
        <!-- Ensure system bars are white during Flutter splash -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- Ensure system bars are white while Flutter UI initializes -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- 权限向导页专用主题：浅色背景 + 透明系统栏 + 深色图标，
         与主页 WebView 的浅色系统栏保持一致，避免进入向导页时上下栏突变深。
         系统栏颜色必须在主题中声明（各 values 变体各自定义），
         仅靠代码设置在高版本 Android/部分 ROM 上不可靠。 -->
    <style name="Theme.Liminal.Wizard" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#F7F9F5</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!--
      对话框宿主主题（亮/暗两套）：NativeWebViewActivity 内的「即将离开站点」等对话框
      按 Misskey 当前生效主题（pageThemeDark）选择，使外壳对话框跟随站内深浅而非系统。
      MainActivity（WebView 启动前，无站内信息）仍用下方 DayNight 版本跟随系统。
    -->
    <style name="Theme.Liminal.Dialog.Host" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1A73E8</item>
        <item name="colorOnPrimary">@android:color/white</item>
    </style>
    <style name="Theme.Liminal.Dialog.Host.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#1A73E8</item>
        <item name="colorOnPrimary">@android:color/white</item>
    </style>
    <style name="Theme.Liminal.Dialog.Host.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#8AB4F8</item>
        <item name="colorOnPrimary">#0B1B33</item>
    </style>

    <!-- 权限向导暗色变体：由 PermissionSetupActivity 按站内深浅状态在代码中 setTheme 选择 -->
    <style name="Theme.Liminal.Wizard.Dark" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">#15171C</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!--
      WebView 宿主专用 DayNight 主题：Chromium WebView 的 prefers-color-scheme 不读系统
      设置，而是读 WebView 构造 Context 主题的 android:isLightTheme（Activity 的
      Theme.Light 恒为浅色，导致站内「跟随设备深浅色」永远读到 light）。
      Material3.DayNight 在浅色下 isLightTheme=true、夜间=false，用
      ContextThemeWrapper 套在本 Activity 上创建 WebView 即可让媒体查询跟随系统。
      仅包 WebView；壳层系统栏/对话框等另有跟随站内主题的深浅适配逻辑。
      注：android:isLightTheme 为 API 29+ 属性，API ≤28 设备属性不存在、
      WebView 恒报 light（Chromium 行为，无主题层解法，站内手动切换主题不受影响）。
    -->
    <style name="Theme.Liminal.WebView" parent="Theme.Material3.DayNight.NoActionBar" />
</resources>
